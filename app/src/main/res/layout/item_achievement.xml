<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@android:color/transparent">

    <LinearLayout
        android:id="@+id/layout_achievement"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical"
        android:background="@drawable/neumorphic_bg">

        <TextView
            android:id="@+id/text_achievement_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:gravity="center"
            android:text="🏆"
            android:textSize="36sp"
            android:padding="8dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_achievement_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Achievement Title"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#333333" />

            <TextView
                android:id="@+id/text_achievement_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requirement for this badge"
                android:textSize="14sp"
                android:textColor="#777777" />

        </LinearLayout>

        <ImageView
            android:id="@+id/image_earned_status"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/checkbox_off_background"
            app:tint="#CCCCCC" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
